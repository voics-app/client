{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "composite": true,
    "outDir": "./out/tsc-node"
  },
  "include": [
    "brand.json",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright*.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/e2e/**/*",
    "tests/browser/**/*",
    "tests/unit/main/**/*"
  ]
}
