{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "composite": true,
    "outDir": "./out/tsc-web",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "brand.json","src/renderer/**/*", "src/shared/**/*", "src/preload/api.d.ts", "tests/unit/**/*"],
  "exclude": ["tests/unit/main/**"]
}
