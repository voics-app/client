{
  "name": "@discordy/crypto",
  "version": "0.1.0",
  "private": true,
  "description": "Discordy native crypto: OpenMLS groups, Ed25519 device identity and a SQLCipher local store (napi-rs)",
  "license": "UNLICENSED",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "discordy-crypto",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --no-js --dts native.d.ts",
    "build:debug": "napi build --platform --no-js --dts native.d.ts",
    "test": "cargo test --release",
    "lint": "cargo fmt --check && cargo clippy --release --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.4.1"
  }
}
