# Development-only values. Copy to .env (never committed) or export in your shell.
# Connection profile: production | local | custom
DISCORDY_PROFILE=local
# Override individual endpoints (used when DISCORDY_PROFILE=custom, or to override a profile)
DISCORDY_API_URL=http://localhost:8000
DISCORDY_GATEWAY_URL=ws://localhost:8000
DISCORDY_CDN_URL=http://localhost:8000/cdn
# Auto-update feed (electron-updater generic provider)
UPDATE_FEED_URL=https://updates.voics.nl
