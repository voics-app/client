{
  "name": "@discordy/core",
  "version": "0.0.1",
  "private": true,
  "description": "Platform-free domain rules and protocol contracts shared by the desktop and mobile clients",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./domain/*": "./src/domain/*.ts",
    "./contracts": "./src/contracts/index.ts",
    "./contracts/*": "./src/contracts/*.ts",
    "./application/*": "./src/application/*.ts",
    "./infrastructure/*": "./src/infrastructure/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "zustand": "5.0.8"
  }
}
