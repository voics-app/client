{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "ESNext", "moduleResolution": "Bundler",
    "types": ["node"], "strict": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "isolatedModules": true, "forceConsistentCasingInFileNames": true, "noEmit": true
  },
  "include": ["src/**/*"]
}
