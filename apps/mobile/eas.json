{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "node": "24.11.0"
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "node": "24.11.0"
    },
    "simulator": {
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "node": "24.11.0",
      "env": {
        "VOICS_TEST_BACKEND_URL": "https://review-backend.invalid"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "node": "24.11.0"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6831532158",
        "appleTeamId": "H94LRLL489"
      }
    }
  }
}
